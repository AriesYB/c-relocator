{
  "version": 1,
  "comment": "c-relocator 规则库。detect.paths 支持 %ENV% 展开；data.targets 的 {reloc} 占位 reloc 根；config.steps.type: command|env|file_edit|path_update；mechanism: config|junction|deny。risk=medium 及以上 migrate 前必须用户确认。",
  "rules": [
    {
      "id": "deny-windows",
      "name": "Windows 系统目录（永不操作）",
      "mechanism": "deny",
      "detect": { "paths": ["%SystemRoot%"], "processes": [] },
      "notes": "WinSxS、Installer、System32 等被系统机制依赖，junction 会导致更新/修复异常。"
    },
    {
      "id": "deny-managed-apps",
      "name": "微软托管应用数据（永不操作）",
      "mechanism": "deny",
      "detect": {
        "paths": [
          "C:\\Program Files\\WindowsApps",
          "%ProgramData%\\Microsoft",
          "%LOCALAPPDATA%\\Microsoft",
          "%APPDATA%\\Microsoft",
          "%LOCALAPPDATA%\\Packages",
          "C:\\Program Files\\Microsoft Office",
          "C:\\Program Files\\Common Files\\microsoft shared\\ClickToRun",
          "%ProgramData%\\Package Cache"
        ],
        "processes": []
      },
      "notes": "Store 应用、Defender/搜索索引、Office ClickToRun、Installer 缓存；脚本内置同一份名单双重防线。"
    },
    {
      "id": "npm",
      "name": "npm 全局包（prefix）与下载缓存（cache）",
      "mechanism": "config",
      "detect": {
        "paths": ["%APPDATA%\\npm", "%LOCALAPPDATA%\\npm-cache"],
        "processes": ["node"]
      },
      "config": {
        "steps": [
          { "type": "command", "cmd": "npm config set prefix \"{reloc}\\npm\"", "undo": "npm config delete prefix" },
          { "type": "command", "cmd": "npm config set cache \"{reloc}\\npm-cache\"", "undo": "npm config delete cache" },
          { "type": "path_update", "note": "把用户 PATH 中指向 %APPDATA%\\npm 的条目替换为 {reloc}\\npm（先备份原 PATH）" }
        ]
      },
      "data": {
        "mode": "copy",
        "targets": {
          "%APPDATA%\\npm": "{reloc}\\npm",
          "%LOCALAPPDATA%\\npm-cache": "{reloc}\\npm-cache"
        }
      },
      "verify": ["npm config get prefix", "npm config get cache"],
      "risk": "low",
      "notes": "Windows 下 npm 默认 prefix 是 %APPDATA%\\npm（全局命令所在）；改 prefix 后必须同步改用户 PATH，否则 npm i -g 装的 CLI 全部失效。nvm-windows 用户实际 prefix 可能是 nvm 根目录（动手前先 npm config get prefix 确认），PATH 里挂的 npm 目录不一定是活 prefix 但其中的全局命令可能仍被使用。npm 生成的 .cmd shim 用 %~dp0 相对路径，整目录平移 + PATH 改指即可无损；验证 shim 用 PowerShell & 调用（个别宿主直跑 .cmd 会报 0xC0000142 假失败）。"
    },
    {
      "id": "pip-cache",
      "name": "pip 下载缓存",
      "mechanism": "config",
      "detect": {
        "paths": ["%LOCALAPPDATA%\\pip\\cache"],
        "processes": []
      },
      "config": {
        "steps": [
          { "type": "command", "cmd": "pip config set global.cache-dir \"{reloc}\\pip-cache\"", "undo": "pip config unset global.cache-dir" }
        ]
      },
      "data": {
        "mode": "copy",
        "targets": {
          "%LOCALAPPDATA%\\pip\\cache": "{reloc}\\pip-cache"
        }
      },
      "verify": ["pip cache dir"],
      "risk": "low",
      "notes": "verify 用 pip cache dir 检查实际生效路径，应输出 {reloc}\\pip-cache。"
    },
    {
      "id": "jetbrains-system",
      "name": "JetBrains IDE 缓存与索引（%LOCALAPPDATA%\\JetBrains 整目录）",
      "mechanism": "junction",
      "detect": {
        "paths": ["%LOCALAPPDATA%\\JetBrains"],
        "processes": ["idea*", "pycharm*", "webstorm*", "clion*", "goland*", "rider*", "datagrip*", "phpstorm*", "rubymine*", "studio64*", "jcef*"]
      },
      "data": {
        "mode": "junction",
        "targets": {
          "%LOCALAPPDATA%\\JetBrains": "{reloc}\\jetbrains-system"
        }
      },
      "verify": [],
      "risk": "low",
      "notes": "索引/缓存在 Local，配置在 Roaming（体积小、不动）；junction 后首次打开 IDE 确认配置与插件完好。jcef* 是 IDE 内嵌浏览器进程。"
    },
    {
      "id": "gradle",
      "name": "Gradle 用户目录（依赖缓存 + wrapper 发行版）",
      "mechanism": "config",
      "detect": {
        "paths": ["%USERPROFILE%\\.gradle"],
        "processes": ["java"]
      },
      "config": {
        "steps": [
          { "type": "env", "name": "GRADLE_USER_HOME", "value": "{reloc}\\gradle-home" }
        ]
      },
      "data": {
        "mode": "copy",
        "targets": {
          "%USERPROFILE%\\.gradle": "{reloc}\\gradle-home"
        }
      },
      "verify": ["新开终端执行: set GRADLE_USER_HOME"],
      "risk": "medium",
      "notes": "java 进程可能是 Gradle daemon，先 gradle --stop 再迁移；也可能是无关 JVM 程序，误报时向用户确认。"
    },
    {
      "id": "cargo-rustup",
      "name": "Rust 工具链与包缓存（cargo + rustup）",
      "mechanism": "config",
      "detect": {
        "paths": ["%USERPROFILE%\\.cargo", "%USERPROFILE%\\.rustup"],
        "processes": ["rustc", "cargo", "rust-analyzer"]
      },
      "config": {
        "steps": [
          { "type": "env", "name": "CARGO_HOME", "value": "{reloc}\\cargo-home" },
          { "type": "env", "name": "RUSTUP_HOME", "value": "{reloc}\\rustup-home" },
          { "type": "path_update", "note": "用户 PATH 中 %USERPROFILE%\\.cargo\\bin 替换为 {reloc}\\cargo-home\\bin（先备份原 PATH）" }
        ]
      },
      "data": {
        "mode": "copy",
        "targets": {
          "%USERPROFILE%\\.cargo": "{reloc}\\cargo-home",
          "%USERPROFILE%\\.rustup": "{reloc}\\rustup-home"
        }
      },
      "verify": ["cargo --version", "rustup show"],
      "risk": "medium",
      "notes": "PATH 必须同步更新，否则 rustup/cargo 失效；VS Code 的 rust-analyzer 重启后生效。"
    },
    {
      "id": "go",
      "name": "Go 工作区与模块缓存（GOPATH）",
      "mechanism": "config",
      "detect": {
        "paths": ["%USERPROFILE%\\go"],
        "processes": ["go", "gopls"]
      },
      "config": {
        "steps": [
          { "type": "env", "name": "GOPATH", "value": "{reloc}\\go-home" }
        ]
      },
      "data": {
        "mode": "copy",
        "targets": {
          "%USERPROFILE%\\go": "{reloc}\\go-home"
        }
      },
      "verify": ["go env GOPATH"],
      "risk": "low",
      "notes": "GOPATH 默认 %USERPROFILE%\\go；未设 GOBIN 时可执行文件在 GOPATH\\bin，注意 PATH 是否引用旧路径。"
    },
    {
      "id": "huggingface",
      "name": "HuggingFace / PyTorch 模型缓存",
      "mechanism": "config",
      "detect": {
        "paths": ["%USERPROFILE%\\.cache\\huggingface", "%USERPROFILE%\\.cache\\torch"],
        "processes": ["python"]
      },
      "config": {
        "steps": [
          { "type": "env", "name": "HF_HOME", "value": "{reloc}\\hf-home" },
          { "type": "env", "name": "TORCH_HOME", "value": "{reloc}\\torch-home" }
        ]
      },
      "data": {
        "mode": "copy",
        "targets": {
          "%USERPROFILE%\\.cache\\huggingface\\hub": "{reloc}\\hf-home\\hub",
          "%USERPROFILE%\\.cache\\huggingface\\datasets": "{reloc}\\hf-home\\datasets",
          "%USERPROFILE%\\.cache\\torch": "{reloc}\\torch-home"
        }
      },
      "verify": [],
      "risk": "low",
      "notes": "HF_HOME 指向根目录，hub/datasets 缓存在其子目录下，因此按子目录映射；python 进程在跑时先确认是否训练任务。"
    },
    {
      "id": "maven-m2",
      "name": "Maven 本地仓库（.m2\\repository，settings.xml 指路）",
      "mechanism": "config",
      "detect": {
        "paths": ["%USERPROFILE%\\.m2\\repository"],
        "processes": ["java"]
      },
      "config": {
        "steps": [
          { "type": "file_edit", "note": "~/.m2/settings.xml 不存在则创建最小内容 <settings><localRepository>{reloc}\\m2\\repository</localRepository></settings>（本地路径用正斜杠）；已存在则只改 localRepository 元素" }
        ]
      },
      "data": {
        "mode": "copy",
        "targets": {
          "%USERPROFILE%\\.m2\\repository": "{reloc}\\m2\\repository"
        }
      },
      "verify": ["读回 ~/.m2/settings.xml 确认 localRepository 指向新位置"],
      "risk": "low",
      "notes": "settings.xml 本体保留在 ~/.m2 不动（Maven 默认从那里读）；IDEA 某些项目可能用自己的 Maven 覆盖设置，若有项目报仓库路径异常去 IDEA 的 Maven 设置里检查。"
    },
    {
      "id": "maven-wrapper",
      "name": "Maven wrapper 发行版缓存（.m2\\wrapper）",
      "mechanism": "junction",
      "detect": {
        "paths": ["%USERPROFILE%\\.m2\\wrapper"],
        "processes": ["java"]
      },
      "data": {
        "mode": "junction",
        "targets": {
          "%USERPROFILE%\\.m2\\wrapper": "{reloc}\\m2\\wrapper"
        }
      },
      "verify": [],
      "risk": "low",
      "notes": "mvnw 脚本与 IntelliJ 硬编码 ~/.m2/wrapper，无官方可迁移配置，按本项目规则 junction 兜底。"
    },
    {
      "id": "bun",
      "name": "Bun 运行时与缓存（~\\.bun）",
      "mechanism": "config",
      "detect": {
        "paths": ["%USERPROFILE%\\.bun"],
        "processes": ["bun"]
      },
      "config": {
        "steps": [
          { "type": "env", "name": "BUN_INSTALL", "value": "{reloc}\\bun-home" },
          { "type": "path_update", "note": "用户 PATH 中 %USERPROFILE%\\.bun\\bin 条目替换为 {reloc}\\bun-home\\bin（先备份原 PATH；若原条目指向空目录，替换后等价无害）" }
        ]
      },
      "data": {
        "mode": "copy",
        "targets": {
          "%USERPROFILE%\\.bun": "{reloc}\\bun-home"
        }
      },
      "verify": ["BUN_INSTALL 用户环境变量指向新位置", "抽查 E 盘侧 install\\cache 下的 junction 已改写为自洽目标"],
      "risk": "low",
      "notes": "BUN_INSTALL 是 Bun 官方的 home 目录变量（bin/cache/安装的包都在其下）；bun.exe 本体在 bin 子目录，PATH 必须同步替换。"
    },
    {
      "id": "vscode-extensions",
      "name": "VS Code 扩展目录（~\\.vscode）",
      "mechanism": "config",
      "detect": {
        "paths": ["%USERPROFILE%\\.vscode"],
        "processes": ["Code"]
      },
      "config": {
        "steps": [
          { "type": "env", "name": "VSCODE_EXTENSIONS", "value": "{reloc}\\vscode-extensions" }
        ]
      },
      "data": {
        "mode": "copy",
        "targets": {
          "%USERPROFILE%\\.vscode": "{reloc}\\vscode-extensions"
        }
      },
      "verify": ["重开 VS Code 后执行 code --list-extensions 确认扩展齐全"],
      "risk": "low",
      "notes": "VSCODE_EXTENSIONS 是官方支持的环境变量（vscode issue #266395、企业版文档）；迁移前 VS Code 全部进程必须退出；env 设置后下次启动 VS Code 生效。"
    },
    {
      "id": "wpsdrive",
      "name": "WPS 云盘本地同步目录（~\\WPSDrive）",
      "mechanism": "config",
      "detect": {
        "paths": ["%USERPROFILE%\\WPSDrive"],
        "processes": ["wps", "wpspdf", "et", "wpp", "kwps", "wpscloudsvr"]
      },
      "config": {
        "steps": [
          { "type": "manual", "note": "WPS 客户端内：设置 → 存储管理 → 云文档缓存位置，改到 {reloc}\\wpsdrive，WPS 自动迁移缓存/同步内容。官方明确不能直接移动文件夹本身（WPS 官方论坛 wps.cn/topic/100146）。" }
        ]
      },
      "data": {
        "mode": "manual",
        "targets": {}
      },
      "verify": ["新位置出现 E:\\Reloc\\wpsdrive 且内容完整，WPS 同步正常；旧目录确认后删除"],
      "risk": "low",
      "notes": "走 WPS 原生迁移最可靠（同步客户端会正确重建索引），不用 junction 是为规避同步客户端兼容风险。AI 只引导 + 验证 + 记录 manifest，数据迁移由 WPS 自身完成。"
    }
  ]
}
